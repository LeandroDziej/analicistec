# Clave de Gemini (gratuita o paga) de este cliente. Sin clave, la app funciona con el motor propio (sin IA).
GEMINI_API_KEY=

# --- Marca blanca (opcional): la app con el nombre, logo y contacto de la empresa que la ofrece ---
NEXT_PUBLIC_MARCA_NOMBRE=
# Logo de la empresa (link https a una imagen PNG o SVG)
NEXT_PUBLIC_MARCA_LOGO=
# WhatsApp de la empresa (solo números con código de país, ej. 5493415551234) o un link https
NEXT_PUBLIC_MARCA_CONTACTO=
# Dirección pública de esta app (para los links que manda el bot)
NEXT_PUBLIC_URL_APP=
# A dónde van las empresas que quieren contratar el servicio (por defecto https://tecnoros.ar)
NEXT_PUBLIC_CONTACTO_VENTAS=

# --- API para bots (opcional) ---
# Clientes que pueden usar /api/v1/analizar, separados por coma: nombre:clave[:tope_mensual_con_IA]
# La clave debe tener al menos 16 caracteres. Generala con: openssl rand -hex 24
ANTIESTAFA_API_CLIENTES=

# --- Medidor de uso (opcional) ---
# Upstash Redis (tiene plan gratuito). Sin esto, cuenta en memoria y se reinicia con cada despliegue.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
